x␀$ŠsÉöì␀␀␀␀IEND®B`‚local anim8 = {
  _VERSION     = 'anim8 v2.3.1',
  _DESCRIPTION = 'An animation library for LÃ–VE',
  _URL         = 'https://github.com/kikito/anim8',
  _LICENSE     = [[
